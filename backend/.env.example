# CampusFix Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file or real secrets to version control.

# Server
PORT=5000
API_VERSION=v1

# MongoDB
# Local example: mongodb://127.0.0.1:27017/campusfix
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusfix
MONGODB_URI=mongodb://127.0.0.1:27017/campusfix

# JWT
# Generate a strong random secret for real deployments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_development_only_secret
JWT_EXPIRE=7d

# CORS — the origin your frontend (Vite dev server) runs on
CLIENT_URL=http://localhost:5173
